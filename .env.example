# Clave compartida de la pantalla de barra (/barra).
# Mínimo 12 caracteres. Sin esta variable, /barra y las rutas de pedidos
# responden 503: es preferible que la pantalla no funcione a dejarla abierta.
#   Generar una:  openssl rand -base64 24
BARRA_TOKEN=

# Número de mesas con QR. Decide qué valores acepta /mesa/[numero].
NEXT_PUBLIC_NUMERO_MESAS=20

# Ruta del fichero SQLite de pedidos. Por defecto ./data/pedidos.db
# En producción, apúntalo a un volumen persistente.
# PEDIDOS_DB=/var/lib/taberna/pedidos.db
